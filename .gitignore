# Keep project release policy and its entry point versionable despite local excludes.
!/AGENTS.md
!/scripts/publish-eithost.ps1
# EitHost.App.csproj packages this script into the release, so a clone cannot build
# without it. The built copy under release/ is versioned and byte-identical.
!/scripts/update-eithost-install.ps1

# Release archives are regenerated by scripts/package-eithost.ps1; only the
# single delivery directory is versioned (see AGENTS.md).
/release/*.zip

# The self-contained EXE exceeds GitHub's 100 MiB file limit; it ships as a
# GitHub Release asset and is rebuilt locally by scripts/package-eithost.ps1.
/release/EitHost-Windows-x64/EitHost.App.exe
