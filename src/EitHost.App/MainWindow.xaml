                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="激励" Style="{StaticResource FieldLabel}" />
                                                            <Border Grid.Column="1" Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="8,5">
                                                                <TextBlock Text="{Binding RealtimeExcitationSummary}"
                                                                           Style="{StaticResource MonoText}" FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- center: shared display selector + 2x2 live plots -->
                    <!-- A vertical ScrollViewer measures its content with infinite
                         height, so the Stretch="Fill" Viewboxes below would scale the
                         520x220 plot canvases by width alone and grow taller as the
                         window widens. Pinning the content height to the viewport keeps
                         the star rows finite; MinHeight still hands undersized viewports
                         back to the scrollbar. Margins live on the children so the
                         pinned height matches the viewport exactly. -->
                    <ScrollViewer x:Name="RealtimePlotScroll" Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch">
                    <DockPanel MinHeight="560"
                               Height="{Binding ViewportHeight, ElementName=RealtimePlotScroll}">
                        <!-- one shared selector drives all four plots -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelCard}" Padding="12,8" Margin="14,14,14,12">
                            <StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="显示设备" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox MinWidth="220" VerticalAlignment="Center"
                                              ItemsSource="{Binding BoundPairings}"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedRealtimeDisplayPairing}" />
                                </StackPanel>
                                <TextBlock Text="{Binding RealtimeImagingSummary}"
                                           ToolTip="{Binding RealtimeImagingSummary}"
                                           Style="{StaticResource MonoText}" FontSize="11"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                           Height="30" />
                            </WrapPanel>
                            <WrapPanel Margin="0,7,0,0">
                                <CheckBox Content="双平面 2.5D"
                                          ToolTip="两套设备分别完成二维反演后沿 z 线性插值；不填造跨层观测，不是真实 3D CEM 反演。"
                                          ContentTemplate="{StaticResource WrappedCheckLabel}"
                                          IsChecked="{Binding Pseudo3dEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,12,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                                    <TextBlock Text="下层设备" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox MinWidth="140"
                                              ItemsSource="{Binding BoundPairings}"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedPseudo3dLowerPairing}"
                                              IsEnabled="{Binding Pseudo3dEnabled}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                                    <TextBlock Text="上层设备" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox MinWidth="140"
                                              ItemsSource="{Binding BoundPairings}"
                                              DisplayMemberPath="Title"
                                              SelectedItem="{Binding SelectedPseudo3dUpperPairing}"
                                              IsEnabled="{Binding Pseudo3dEnabled}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4">
                                    <TextBlock Text="显示层数" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox MinWidth="38"
                                             ToolTip="允许 2–9 层；默认 5 层。"
                                             IsEnabled="{Binding Pseudo3dEnabled}">
                                        <TextBox.Text>
                                            <Binding Path="Pseudo3dDisplayLayers" UpdateSourceTrigger="LostFocus">
                                                <Binding.ValidationRules>
                                                    <StaticResource ResourceKey="Pseudo3dDisplayLayerRule" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4">
                                    <TextBlock Text="归一化高度" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox MinWidth="46"
                                             ToolTip="相对模型半径的显示高度，不代表毫米。"
                                             IsEnabled="{Binding Pseudo3dEnabled}">
                                        <TextBox.Text>
                                            <Binding Path="Pseudo3dNormalizedHeight" UpdateSourceTrigger="LostFocus">
                                                <Binding.ValidationRules>
                                                    <StaticResource ResourceKey="Pseudo3dNormalizedHeightRule" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <TextBlock Text="配对容差 ms" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox MinWidth="54"
                                             ToolTip="两层采集时间差超过此值时拒绝合成。"
                                             IsEnabled="{Binding Pseudo3dEnabled}">
                                        <TextBox.Text>
                                            <Binding Path="Pseudo3dMaximumPairSkewMilliseconds" UpdateSourceTrigger="LostFocus">
                                                <Binding.ValidationRules>
                                                    <StaticResource ResourceKey="Pseudo3dPairSkewRule" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding RealtimePseudo3dStatus}"
                                       ToolTip="{Binding RealtimePseudo3dStatus}"
                                       Style="{StaticResource MonoText}" FontSize="10" Margin="0,2,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding RealtimePseudo3dProvenance}"
                                       ToolTip="{Binding RealtimePseudo3dProvenance}"
                                       Style="{StaticResource HintText}" FontSize="10" Margin="0,2,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="14,0,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}">
                                <DockPanel Margin="12">
                                    <StackPanel DockPanel.Dock="Top">
                                        <Grid Height="30">
                                            <TextBlock Text="原始边界电压 CH1" ToolTip="原始边界电压 CH1" Style="{StaticResource H3Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{Binding RealtimeRawWaveStats}"
                                                   ToolTip="{Binding RealtimeRawWaveStats}"
                                                   Style="{StaticResource MonoText}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" Height="30" />
                                    </StackPanel>
                                    <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="8">
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="520" Height="220">
                                                <Line X1="0" X2="520" Y1="55" Y2="55" Stroke="{StaticResource DividerBrush}" />
                                                <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="{StaticResource DividerBrush}" />
                                                <Line X1="0" X2="520" Y1="165" Y2="165" Stroke="{StaticResource DividerBrush}" />
                                                <Path Data="{Binding RealtimeRawChannel1Geometry}"
                                                      Stroke="#0b78c8" StrokeThickness="2.4"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelCard}">
                                <DockPanel Margin="12">
                                    <StackPanel DockPanel.Dock="Top">
                                        <WrapPanel MinHeight="30">
                                            <TextBlock Text="{Binding RealtimeSignalViewTitle}"
                                                       ToolTip="{Binding RealtimeSignalViewTitle}"
                                                       Style="{StaticResource H3Text}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,4" />
                                            <ComboBox MinWidth="150" Height="30" Margin="0,0,6,4"
                                                      ItemsSource="{Binding RealtimeDemodDisplayModeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding RealtimeDemodDisplayMode}"
                                                      IsEnabled="{Binding IsRealtimeDemodViewSelected}"
                                                      ToolTip="默认显示 EIDORS 对齐的实部/虚部；专家模式显示幅值/相位" />
                                            <ComboBox MinWidth="104" Height="30" Margin="0,0,0,4"
                                                      ItemsSource="{Binding RealtimeSignalViewOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding RealtimeSignalViewMode}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding RealtimeDemodStats}"
                                                   ToolTip="{Binding RealtimeDemodStats}"
                                                   Style="{StaticResource MonoText}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" Height="30" />
                                        <TextBlock Text="{Binding RealtimeDemodLegend}"
                                                   Style="{StaticResource HintText}" FontSize="10" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="8">
                                        <Viewbox Stretch="Fill">
                                            <Grid Width="594" Height="220">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="520" />
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl x:Name="RealtimeDemodYAxisTicksControl"
                                                              Grid.Column="0" Width="68" Height="220"
                                                              ItemsSource="{Binding RealtimeDemodYAxisTicks}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas Width="68" Height="220" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" Width="68" TextAlignment="Right">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                                        <Setter Property="FontSize" Value="10" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsZero}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                                <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Canvas x:Name="RealtimeDemodPlotCanvas" Grid.Column="2" Width="520" Height="220">
                                                    <Path Data="{Binding RealtimeDemodGridGeometry}"
                                                          Stroke="{StaticResource DividerBrush}" StrokeThickness="1" />
                                                    <Path Data="{Binding RealtimeDemodZeroLineGeometry}"
                                                          Stroke="#64748b" StrokeThickness="1.8" />
                                                    <Path Data="{Binding RealtimeDemodPrimaryGeometry}"
                                                          Stroke="#0b78c8" StrokeThickness="2.4"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="{Binding RealtimeDemodSecondaryGeometry}"
                                                          Stroke="#c7352b" StrokeThickness="2.0" Opacity="0.85"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelCard}">
                                <DockPanel Margin="12">
                                    <StackPanel DockPanel.Dock="Top">
                                        <Grid Height="30">
                                            <TextBlock Text="边界电压拟合" ToolTip="边界电压拟合" Style="{StaticResource H3Text}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Text="{Binding RealtimeBoundaryStats}"
                                                   ToolTip="{Binding RealtimeBoundaryStats}"
                                                   Style="{StaticResource MonoText}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" Height="30" />
                                    </StackPanel>
                                    <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Height="220" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding RealtimeBoundaryYAxisTop}"
                                                           Style="{StaticResource MonoText}" FontSize="10"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding RealtimeBoundaryYAxisMiddle}"
                                                           Style="{StaticResource MonoText}" FontSize="10"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RealtimeBoundaryYAxisBottom}"
                                                           Style="{StaticResource MonoText}" FontSize="10"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Viewbox Grid.Column="1" Stretch="Fill">
                                                <Canvas Width="520" Height="220">
                                                    <Line X1="0" X2="520" Y1="55" Y2="55" Stroke="{StaticResource DividerBrush}" />
                                                    <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="{StaticResource DividerBrush}" />
                                                    <Line X1="0" X2="520" Y1="165" Y2="165" Stroke="{StaticResource DividerBrush}" />
                                                    <Path Data="{Binding RealtimeBoundaryReferenceGeometry}"
                                                          Stroke="#c7352b" StrokeThickness="2.0" StrokeDashArray="5,4" Opacity="0.85"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="{Binding RealtimeBoundaryTemplateGeometry}"
                                                          Stroke="#16a34a" StrokeThickness="2.0" StrokeDashArray="2,5" Opacity="0.9"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="{Binding RealtimeBoundaryTargetGeometry}"
                                                          Stroke="#0b78c8" StrokeThickness="2.4"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelCard}">
                                <DockPanel Margin="12">
                                    <Grid DockPanel.Dock="Top" Height="30">
                                        <TextBlock Text="重构图像" ToolTip="重构图像" Style="{StaticResource H3Text}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <!-- The diagnostics column carries wrapped prose, so it keeps a
                                             larger share than the square image needs for its Uniform fit. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource SunkenBrush}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="8">
                                            <Viewbox x:Name="RealtimeImageViewbox" Stretch="Uniform"
                                                     SizeChanged="ImageSurface_SizeChanged">
                                            <Grid Width="{Binding RoiImageCanvasSize}"
                                                  Height="{Binding RoiImageCanvasSize}">
                                            <Canvas x:Name="RealtimeRoiCanvas"
                                                    Width="{Binding RoiImageCanvasSize}"
                                                    Height="{Binding RoiImageCanvasSize}"
                                                    Visibility="{Binding Realtime2dImageVisibility}"
                                                    Background="Transparent"
                                                    ClipToBounds="True"
                                                    Cursor="Cross"
                                                    MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                                    MouseMove="RoiCanvas_MouseMove"
                                                    MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp">
                                                <Image Source="{Binding RealtimeImageSource}"
                                                       Width="{Binding RoiImageCanvasSize}"
                                                       Height="{Binding RoiImageCanvasSize}"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True" />
                                                <ItemsControl ItemsSource="{Binding RealtimeFixedRoiMapCells}"
                                                              Visibility="{Binding RoiFixedGridVisibility}"
                                                              Width="{Binding RoiImageCanvasSize}"
                                                              Height="{Binding RoiImageCanvasSize}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Width="{Binding DataContext.RoiImageCanvasSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    Height="{Binding DataContext.RoiImageCanvasSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Path Data="{Binding Geometry}" Fill="{Binding Fill}"
                                                                  Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Path Data="{Binding RealtimeFixedRoiTemporal.CentroidTrajectory}"
                                                      Visibility="{Binding RoiFixedGridVisibility}"
                                                      Stroke="#fff7ed" StrokeThickness="2.6" StrokeDashArray="4,3"
                                                      IsHitTestVisible="False" />
                                                <Ellipse Canvas.Left="{Binding RealtimeFixedRoiTemporal.CentroidLeft}"
                                                         Canvas.Top="{Binding RealtimeFixedRoiTemporal.CentroidTop}"
                                                         Width="12" Height="12" Fill="#fff7ed" Stroke="#9a3412"
                                                         StrokeThickness="2" Visibility="{Binding RealtimeFixedRoiTemporal.CentroidVisibility}"
                                                         IsHitTestVisible="False" />
                                                <Path Data="{Binding FixedRoiSelectionGeometry}"
                                                      Visibility="{Binding RoiFixedGridVisibility}"
                                                      Fill="#44f4c430" Stroke="#f4c430" StrokeThickness="2.5"
                                                      IsHitTestVisible="False" />
                                                <Path Data="{Binding FixedRoiGridGeometry}"
                                                      Visibility="{Binding RoiFixedGridVisibility}"
                                                      Stroke="#e6f8fafc" StrokeThickness="1.4"
                                                      IsHitTestVisible="False" />
                                                <Rectangle Canvas.Left="{Binding RoiOverlayLeft}"
                                                           Canvas.Top="{Binding RoiOverlayTop}"
                                                           Width="{Binding RoiOverlaySize}"
                                                           Height="{Binding RoiOverlaySize}"
                                                           Visibility="{Binding RoiSquareVisibility}"
                                                           Stroke="#f4c430" StrokeThickness="3"
                                                           StrokeDashArray="7,4" Fill="#22f4c430"
                                                           IsHitTestVisible="False" />
                                                <Ellipse Canvas.Left="{Binding RoiOverlayLeft}"
                                                         Canvas.Top="{Binding RoiOverlayTop}"
                                                         Width="{Binding RoiOverlaySize}"
                                                         Height="{Binding RoiOverlaySize}"
                                                         Visibility="{Binding RoiCircleVisibility}"
                                                         Stroke="#f4c430" StrokeThickness="3"
                                                         StrokeDashArray="7,4" Fill="#22f4c430"
                                                         IsHitTestVisible="False" />
                                                <Border Width="{Binding RoiImageCanvasSize}"
                                                        Height="{Binding RoiImageCanvasSize}"
                                                        Visibility="{Binding RealtimeReferenceInvalidatedVisibility}"
                                                        Background="#99000000"
                                                        IsHitTestVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="14,0">
                                                        <TextBlock Text="参考帧失效"
                                                                   FontSize="28" FontWeight="Bold"
                                                                   Foreground="#fff7ed"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="请重锁参考"
                                                                   FontSize="15"
                                                                   Foreground="#fed7aa"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                 <Border Width="{Binding RoiImageCanvasSize}"
                                                         Height="{Binding RoiImageCanvasSize}"
                                                         Visibility="{Binding RealtimeLowConfidenceImageVisibility}"
                                                         Background="#26000000"
                                                         IsHitTestVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="14,0">
                                                        <TextBlock Text="低置信度重构"
                                                                   FontSize="24" FontWeight="Bold"
                                                                   Foreground="#fef3c7"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="图像仅供参考"
                                                                   FontSize="14"
                                                                   Foreground="#fde68a"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                            <Grid Visibility="{Binding RealtimePseudo3dVisibility}"
                                                  Background="#FFF8FAFC"
                                                  IsHitTestVisible="False">
                                                <Image Source="{Binding RealtimePseudo3dImageSource}"
                                                       Width="{Binding RoiImageCanvasSize}"
                                                       Height="{Binding RoiImageCanvasSize}"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True" />
                                            </Grid>
                                            </Grid>
                                            </Viewbox>
                                        </Border>
                                        <ScrollViewer x:Name="RealtimeReconstructionDiagnostics"
                                                      Grid.Column="2"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RealtimeReconstructionActivity}"
                                                           ToolTip="{Binding RealtimeReconstructionActivity}"
                                                           Style="{StaticResource MonoText}" FontSize="11"
                                                           Foreground="#0b78c8"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                           Height="60" />
                                                <TextBlock Text="{Binding RealtimeImageStats}"
                                                           ToolTip="{Binding RealtimeImageStats}"
                                                           Style="{StaticResource MonoText}" FontSize="11" Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RealtimeBaselineIntegritySummary}"
                                                           ToolTip="{Binding RealtimeBaselineIntegritySummary}"
                                                           Style="{StaticResource MonoText}" FontSize="11" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RealtimeContactSummary}"
                                                           ToolTip="{Binding RealtimeContactSummary}"
                                                           Style="{StaticResource MonoText}" FontSize="11" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RealtimeMultiFrequencySummary}"
                                                           ToolTip="{Binding RealtimeMultiFrequencySummary}"
                                                           Style="{StaticResource MonoText}" FontSize="11" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" />
                                                <Border Background="{StaticResource SunkenBrush}"
                                                        BorderBrush="{StaticResource DividerBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="7,6" Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding RealtimeDataQualityStatus}" Style="{StaticResource MonoText}" FontSize="10" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RealtimeReferenceModeStatus}" Style="{StaticResource MonoText}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RealtimeReconstructionQualityStatus}" Style="{StaticResource MonoText}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding RealtimeRoiReadinessStatus}" Style="{StaticResource MonoText}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                    </ScrollViewer>

                    <!-- right frame/log panel -->
                    <Border x:Name="RealtimeRightPane" Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="16,10,16,8"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
