<Window x:Class="EitHost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        MinHeight="640"
        MinWidth="1024"
        Height="820"
        Width="1280"
        WindowStartupLocation="Manual"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel LastChildFill="True">
        <!-- ════════ Title bar with inline menu ════════ -->
        <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="9" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.4" Background="{StaticResource AccentTintBrush}">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EIT 工作站" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource Text1Brush}" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="· EitHost v1.0" Style="{StaticResource MonoText}" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Menu Grid.Column="1" Background="Transparent" BorderThickness="0"
                      VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12">
                    <MenuItem x:Name="FileMenuItem" Header="文件(F)">
                        <MenuItem Header="刷新 catalog" Command="{Binding RefreshCatalogRunsCommand}" />
                        <MenuItem Header="导出现场快照" Command="{Binding ExportFieldSnapshotCommand}" />
                        <Separator />
                        <MenuItem Header="退出" Click="CloseButton_Click" />
                    </MenuItem>
                    <MenuItem Header="视图(V)">
                        <MenuItem Header="实测工作台" Click="ShowRealtimeMenu_Click" />
                        <MenuItem Header="仪表盘" Click="ShowDashboardMenu_Click" />
                        <MenuItem Header="设备配对" Click="ShowPairingMenu_Click" />
                        <MenuItem Header="控制" Click="ShowControlMenu_Click" />
                        <MenuItem Header="数据库" Click="ShowDataMenu_Click" />
                        <MenuItem Header="系统日志" Click="ShowLogMenu_Click" />
                    </MenuItem>
                    <MenuItem Header="工具(T)">
                        <MenuItem Header="扫描新增设备" Command="{Binding DetectNewDevicesCommand}" />
                        <MenuItem Header="生成硬件报告" Command="{Binding GenerateHardwareSmokeReportCommand}" />
                        <MenuItem Header="安装/修复驱动" Command="{Binding InstallUsb2070DriverCommand}" />
                    </MenuItem>
                    <MenuItem x:Name="LanguageMenuItem" Header="语言(L)">
                        <MenuItem x:Name="SimplifiedChineseMenuItem"
                                  Header="简体中文"
                                  IsCheckable="True"
                                  IsChecked="True"
                                  Click="LanguageMenuItem_Click" />
                        <MenuItem x:Name="EnglishMenuItem"
                                  Header="English"
                                  IsCheckable="True"
                                  Click="LanguageMenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="帮助(H)">
                        <MenuItem Header="系统日志" Click="ShowLogMenu_Click" />
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource WindowChromeButton}" Click="MinimizeButton_Click" />
                    <Button Content="□" Style="{StaticResource WindowChromeButton}" Click="MaximizeButton_Click" />
                    <Button Content="×" Style="{StaticResource WindowChromeCloseButton}" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════ Workstation toolbar ════════ -->
        <Border DockPanel.Dock="Top" Height="46" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding BoundPairings.Count, StringFormat=2D · 16E×1R · {0} 套 · 200 kHz}"
                           Style="{StaticResource MonoText}" FontSize="11" VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="目标套" FontSize="12" Foreground="{StaticResource Text2Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding BoundPairings}"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedBoundPairing}"
                                  ToolTip="选择单套目标设备，「本套」按钮对其生效" />
                        <Border Width="1" Height="20" Background="{StaticResource DividerBrush}" Margin="10,0" />
                        <Button Content="启动本套" Command="{Binding StartRealtimeImagingCommand}"
                                Style="{StaticResource WorkbenchPrimaryToolButton}" ToolTip="启动上方所选目标套的实时采集 + 成像" />
                        <Button Content="停止本套" Command="{Binding StopRealtimeImagingCommand}"
                                Style="{StaticResource WorkbenchDangerToolButton}" ToolTip="停止上方所选目标套的实时成像" />
                        <Border Width="1" Height="20" Background="{StaticResource DividerBrush}" Margin="6,0" />
                        <Button Content="全部启动" Command="{Binding StartAllRealtimeImagingCommand}"
                                Style="{StaticResource WorkbenchPrimaryToolButton}" ToolTip="对全部已绑定套同时启动采集 + 成像" />
                        <Button Content="全部停止" Command="{Binding StopAllDevicesCommand}"
                                Style="{StaticResource WorkbenchDangerToolButton}" ToolTip="急停所有设备的激励与采集" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ════════ Main tabs ════════ -->
        <Border DockPanel.Dock="Top" Height="40" Background="{StaticResource SunkenBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                <RadioButton x:Name="NavDashboard" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="仪表盘" Visibility="Collapsed" Checked="Nav_Checked" />
                <RadioButton x:Name="NavPairing" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="设备配对" Visibility="Collapsed" Checked="Nav_Checked" />
                <RadioButton x:Name="NavControl" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="控制" Visibility="Collapsed" Checked="Nav_Checked" />
                <RadioButton x:Name="NavRealtime" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="实测" IsChecked="True" Checked="Nav_Checked" />
                <RadioButton x:Name="NavData" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="数据库" Checked="Nav_Checked" />
                <RadioButton x:Name="NavLog" Style="{StaticResource WorkbenchTabItem}" GroupName="workbench"
                             Content="系统日志" Visibility="Collapsed" Checked="Nav_Checked" />
            </StackPanel>
        </Border>

        <!-- ════════ Status bar ════════ -->
        <Border DockPanel.Dock="Bottom" Height="32" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPillActive}">
                        <TextBlock Text="模式  实测" Style="{StaticResource StatusPillTextActive}" />
                    </Border>
                    <Border Style="{StaticResource StatusPillReady}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding BoundPairings.Count, StringFormat=已绑定  {0} 套}"
                                   Style="{StaticResource StatusPillTextReady}" />
                    </Border>
                    <Border Style="{StaticResource StatusPillNeutral}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding ExperimentRuns.Count, StringFormat=实验  {0}}"
                                   Style="{StaticResource StatusPillTextNeutral}" />
                    </Border>
                </StackPanel>
                <Button x:Name="StatusErrorBadge" DockPanel.Dock="Right"
                        Style="{StaticResource StatusErrorBadgeButton}"
                        Command="{Binding AcknowledgeErrorsCommand}"
                        Content="{Binding UnreviewedErrorCount, StringFormat=失败 {0}}"
                        ToolTip="{Binding UnreviewedErrorSummary}"
                        Visibility="{Binding HasUnreviewedErrors, Converter={StaticResource BoolToVis}}"
                        Margin="12,0,0,0" />
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}"
                           ToolTip="{Binding StatusMessage}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessageSeverity}" Value="Warning">
                                    <Setter Property="Foreground" Value="{StaticResource WarnFgBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessageSeverity}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorFgBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
                <!-- ════════════ 仪表盘 ════════════ -->
                <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <!-- session overview strip -->
                        <Border Style="{StaticResource PanelCard}" Padding="18,16">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="当前会话" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text1Brush}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource ChipInfo}" Margin="10,0,0,0">
                                            <TextBlock Text="实验会话" Style="{StaticResource ChipTextNeutral}"
                                                       Foreground="{StaticResource InfoFgBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CurrentSessionName}" Style="{StaticResource MonoText}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <StackPanel Margin="18,0,0,0">
                                        <TextBlock Text="已绑定" Style="{StaticResource HintText}" />
                                        <TextBlock Text="{Binding BoundPairings.Count}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="18,4,0,4" />
                                    <StackPanel Margin="18,0,0,0">
                                        <TextBlock Text="待配对 USB2070" Style="{StaticResource HintText}" />
                                        <TextBlock Text="{Binding PendingUsb2070Candidates.Count}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text1Brush}" />
                                    </StackPanel>
                                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="18,4,0,4" />
                                    <StackPanel Margin="18,0,0,0">
                                        <TextBlock Text="catalog runs" Style="{StaticResource HintText}" />
                                        <TextBlock Text="{Binding ExperimentRuns.Count}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text1Brush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- per-set status cards -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="每套 = 1× USB2070 + 1× DDS 串口" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="设备状态" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding BoundPairings}" Margin="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="284" Margin="0,0,12,12" Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                            <Ellipse Style="{StaticResource StatusDot}" />
                                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="15" FontWeight="Bold"
                                                                       Foreground="{StaticResource Text1Brush}" Margin="8,0,0,0" />
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="16 ch" Style="{StaticResource MonoText}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Usb2070DeviceNumberLine}" Foreground="{StaticResource Text2Brush}"
                                                               FontSize="12" Margin="0,12,0,0" />
                                                     <TextBlock Text="{Binding DdsLine}" Foreground="{StaticResource Text2Brush}"
                                                                FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Text="{Binding DdsFirmwareLine}" Style="{StaticResource MonoText}"
                                                                FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Text="{Binding Usb2070IdentityLine}" Style="{StaticResource MonoText}"
                                                                FontSize="11" Margin="0,6,0,0" />
                                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,11,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                                        <TextBlock Text="DDS" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource StatusChipDds}" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding DdsStateText}" Style="{StaticResource StatusChipTextDds}" />
                                                        </Border>
                                                        <TextBlock Text="采集" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                                   Margin="10,0,0,0" />
                                                        <Border Style="{StaticResource StatusChipAcquire}" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding AcquireStateText}" Style="{StaticResource StatusChipTextAcquire}" />
                                                         </Border>
                                                     </StackPanel>
                                                     <TextBlock Text="{Binding DdsScanProgressText}" Style="{StaticResource HintText}"
                                                                Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                                 </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!-- workflow + catalog -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                                <StackPanel Margin="16">
                                    <TextBlock Text="操作流程" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="配对工作流" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <ItemsControl ItemsSource="{Binding WorkflowSteps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,10">
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Text2Brush}"
                                                               FontSize="13" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                <StackPanel Margin="16">
                                    <TextBlock Text="eit_catalog.sqlite" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="SQLite Catalog" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding DataRootPath}" Style="{StaticResource MonoText}" />
                                    <TextBlock Text="Catalog 路径" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                    <TextBlock Text="{Binding CatalogPath}" Style="{StaticResource MonoText}" />
                                    <Button Content="刷新 catalog" Command="{Binding RefreshCatalogRunsCommand}"
                                            Style="{StaticResource SubtleButton}" Height="32" HorizontalAlignment="Left"
                                            Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════ 设备配对 ════════════ -->
                <ScrollViewer x:Name="ViewPairing" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <Grid Margin="24" DataContext="{Binding HardwareWorkspace}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <!-- pairing wizard -->
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                            <StackPanel Margin="18">
                                <TextBlock Text="手动配对向导" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="设备配对流程" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                <TextBlock Text="启动后先记录基线，逐套插入硬件，扫描新增候选后绑定标签与 USB2070 编号。"
                                           Style="{StaticResource HintText}" Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="记录基线" Command="{Binding InitializeBaselineCommand}"
                                            Style="{StaticResource PrimaryButton}" MinWidth="104" Margin="0,0,10,0" />
                                    <Button Content="扫描新增设备" Command="{Binding DetectNewDevicesCommand}" MinWidth="128" />
                                </StackPanel>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="新增 USB2070" Style="{StaticResource FieldLabel}" />
                                        <ListBox ItemsSource="{Binding PendingUsb2070Candidates}"
                                                 SelectedItem="{Binding SelectedUsb2070Candidate}" Height="148">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text1Brush}"
                                                                   FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource MonoText}"
                                                                   FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="新增 DDS 串口" Style="{StaticResource FieldLabel}" />
                                        <ListBox ItemsSource="{Binding PendingDdsCandidates}"
                                                 SelectedItem="{Binding SelectedDdsCandidate}" Height="148">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text1Brush}"
                                                                   FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource MonoText}"
                                                                   FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="标签" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PairingLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="USB2070 编号" Style="{StaticResource FieldLabel}" />
                                        <TextBox>
                                            <TextBox.Text>
                                                <Binding Path="PairingUsb2070DeviceNumber" UpdateSourceTrigger="LostFocus">
                                                    <Binding.ValidationRules>
                                                        <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </TextBox.Text>
                                        </TextBox>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="绑定" Command="{Binding BindSelectedDevicesCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- bound device list -->
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                            <StackPanel Margin="18">
                                <TextBlock Text="本次会话已绑定" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="当前设备状态" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                <ListBox ItemsSource="{Binding BoundPairings}" SelectedItem="{Binding SelectedBoundPairing}"
                                         Height="420" Margin="0,12,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}"
                                                           FontWeight="Bold" FontSize="14" Foreground="{StaticResource Text1Brush}" />
                                                <TextBlock Text="{Binding Usb2070Line}" Foreground="{StaticResource Text2Brush}"
                                                           FontSize="12" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding Usb2070DeviceNumberLine}" Foreground="{StaticResource Text2Brush}"
                                                           FontSize="12" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding Usb2070IdentityLine}" Style="{StaticResource MonoText}"
                                                           FontSize="11" Margin="0,4,0,0" />
                                                 <TextBlock Text="{Binding DdsLine}" Foreground="{StaticResource Text2Brush}"
                                                            FontSize="12" Margin="0,4,0,0" />
                                                 <TextBlock Text="{Binding DdsFirmwareLine}" Style="{StaticResource MonoText}"
                                                            FontSize="11" Margin="0,4,0,0" />
                                                 <TextBlock Text="{Binding DdsScanProgressText}" Style="{StaticResource HintText}"
                                                            FontSize="11" Margin="0,4,0,0" />
                                                 <TextBlock Text="{Binding DdsIdentityLine}" Style="{StaticResource MonoText}"
                                                           FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="未显示旧配对；每次重新打开软件都需要重新手动绑定。"
                                           Style="{StaticResource HintText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ════════════ 激励与采集 ════════════ -->
                <ScrollViewer x:Name="ViewControl" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Margin="24">
                        <!-- active set selector -->
                        <Border Style="{StaticResource PanelCard}" Padding="16,12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="当前操作目标" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="单套控制选定一套已绑定设备后生效" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox DockPanel.Dock="Right" Width="240" ItemsSource="{Binding BoundPairings}"
                                          SelectedItem="{Binding SelectedBoundPairing}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- DDS excitation -->
                            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                                <StackPanel Margin="18">
                                    <TextBlock Text="DDS 串口激励板" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="DDS 单独控制" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <StackPanel IsEnabled="{Binding CanEditExcitationSettings}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="频率 Hz" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="DdsFrequencyHz" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="PositiveIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="DAC 通道" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="DdsDacChannel" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="OneBasedChannelRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="电流" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding DdsGainOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Gain"
                                                      SelectedValue="{Binding DdsGain, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="相位 deg" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding DdsPhaseDegreeOptions}"
                                                      SelectedItem="{Binding DdsPhaseDegrees, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="PGA 增益" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding DdsPgaGainOptions}"
                                                      SelectedItem="{Binding DdsPgaGain, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <TextBlock Text="激励模式" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding ExcitationModes}"
                                                      SelectedItem="{Binding SelectedExcitationMode}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="周期数" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="ExcitationChannelCycles" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="PositiveDecimalRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="前丢弃" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="DemodDiscardLeadingCycles" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeDecimalRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="4">
                                            <TextBlock Text="后丢弃" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="DemodDiscardTrailingCycles" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeDecimalRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="扫描圈数（0=连续）" Style="{StaticResource FieldLabel}" />
                                            <TextBox
                                                     ToolTip="0 表示连续扫描；大于 0 需要固件 v1.4+ 扫描状态能力。">
                                                <TextBox.Text>
                                                    <Binding Path="ExcitationScanTimes" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding RealtimeOperatingPointHint}"
                                               Style="{StaticResource HintText}" TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="实时分块" Style="{StaticResource GuideSectionTitle}" Margin="0,14,0,0" />
                                    <ComboBox ItemsSource="{Binding RealtimeBlockModeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding RealtimeBlockModeCode, Mode=TwoWay}"
                                              Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding RealtimeBlockLatencySummary}" Style="{StaticResource HintText}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding DemodEffectiveDiscardSummary}" Style="{StaticResource HintText}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="接触阈值介质配置" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding ContactSubjectProfileOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding ContactSubjectProfile, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="固件构建号 / Git 哈希" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding ContactFirmwareBuildId, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="必须对应当前实际烧录固件；留空时禁用自适应阈值配置匹配。" />
                                        </StackPanel>
                                        <CheckBox Grid.Row="2" Grid.ColumnSpan="3"
                                                  HorizontalAlignment="Stretch"
                                                  IsChecked="{Binding ContactKnownAllConnectedCalibrationArmed}"
                                                  Content="我已确认 16 个电极全部连接，允许本次生成健康阈值配置"
                                                  ContentTemplate="{StaticResource WrappedCheckLabel}"
                                                  ToolTip="E15 等任一电极已断开时禁止勾选，否则会把故障学习成正常。" />
                                    </Grid>
                                    </StackPanel>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="设置 DAC" Command="{Binding SetDacCommand}" MinWidth="86" Height="34" Margin="0,0,8,8" />
                                        <Button Content="停止 DAC" Command="{Binding StopDacCommand}"
                                                ToolTip="扫描运行时请先停止激励，再停止 DAC。"
                                                MinWidth="86" Height="34" Margin="0,0,8,8" />
                                        <Button Content="设置 PGA" Command="{Binding SetPgaCommand}" MinWidth="86" Height="34" Margin="0,0,8,8" />
                                        <Button Content="启动激励" Command="{Binding StartExcitationCommand}" Style="{StaticResource StartExcitationButton}"
                                                MinWidth="86" Height="34" Margin="0,0,8,8" />
                                        <Button Content="停止激励" Command="{Binding StopExcitationCommand}" Style="{StaticResource DangerButton}"
                                                MinWidth="86" Height="34" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- USB2070 acquisition -->
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                <StackPanel Margin="18">
                                    <TextBlock Text="USB2070 采集卡" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="采集单独控制" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <StackPanel IsEnabled="{Binding CanEditAcquisitionSettings}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="USB2070 设备号" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Usb2070DeviceNumber, UpdateSourceTrigger=LostFocus}" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="采样率 Hz" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="AcquisitionSampleRateHz" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="PositiveIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="量程" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding AcquisitionRanges}" SelectedItem="{Binding AcquisitionRange}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="触发模式" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding AcquisitionTriggerModes}" SelectedItem="{Binding AcquisitionTriggerMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="触发源" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding AcquisitionTriggerSources}" SelectedItem="{Binding AcquisitionTriggerSource}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <TextBlock Text="读取行数" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="AcquisitionReadSampleRows" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="ReadSampleRowsRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="延迟" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="AcquisitionTriggerDelay" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="长度" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="AcquisitionTriggerLength" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="电平" Style="{StaticResource FieldLabel}" />
                                            <TextBox>
                                                <TextBox.Text>
                                                    <Binding Path="AcquisitionTriggerLevel" UpdateSourceTrigger="LostFocus">
                                                        <Binding.ValidationRules>
                                                            <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                        </Binding.ValidationRules>
                                                    </Binding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="启动采集" Command="{Binding StartAcquisitionCommand}" Style="{StaticResource StartAcquisitionButton}"
                                                MinWidth="96" Height="34" Margin="0,0,8,8" />
                                        <Button Content="内存快照" Command="{Binding ReadAcquisitionBlockCommand}" MinWidth="96" Height="34" Margin="0,0,8,8" />
                                        <Button Content="快照全部" Command="{Binding ReadAllActiveAcquisitionBlocksCommand}" MinWidth="96" Height="34" Margin="0,0,8,8" />
                                        <Button Content="保存 HDF5" Command="{Binding SaveCapturedBlockCommand}" MinWidth="96" Height="34" Margin="0,0,8,8" />
                                        <Button Content="保存全部" Command="{Binding SaveAllCapturedBlocksCommand}" MinWidth="96" Height="34" Margin="0,0,8,8" />
                                        <Button Content="停止采集" Command="{Binding StopAcquisitionCommand}" Style="{StaticResource DangerButton}"
                                                MinWidth="96" Height="34" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding LastCaptureSummary}" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource Text3Brush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- multi-set sync -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                            <DockPanel LastChildFill="True" Margin="18,16">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="多套同步协调器" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="多套同步启动" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                    <TextBlock Text="沿用上方各套的激励/采集参数。同步启动让所有已绑定套同时启动激励与采集；全部停止可随时急停所有套。需 ≥2 套设备；下位机未必返回 ACK，软件会记录发送的数据包 HEX 和状态。"
                                               Style="{StaticResource HintText}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button Content="同步启动" Command="{Binding SyncStartCommand}" Style="{StaticResource PrimaryButton}"
                                            MinWidth="104" Margin="0,0,10,0" />
                                    <Button Content="全部停止" Command="{Binding StopAllDevicesCommand}" Style="{StaticResource DangerButton}"
                                            MinWidth="104" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ════════════ 实测工作台 / 实时成像 ════════════ -->
                <Grid x:Name="ViewRealtime" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="288" />
                    </Grid.ColumnDefinitions>

                    <!-- left setup guide -->
                    <Border x:Name="RealtimeGuidePane" Grid.Column="0" Background="{StaticResource CanvasBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                        <DockPanel LastChildFill="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="14">
                                    <Border Style="{StaticResource WorkbenchStepCard}">
                                        <StackPanel>
                                            <ToggleButton x:Name="GuideConnectToggle"
                                                          Click="GuideToggle_Click"
                                                          Style="{StaticResource WorkbenchGuideHeader}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12"
                                                            Background="{StaticResource AccentTintBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="一" Foreground="{StaticResource AccentBrush}"
                                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="连接" FontWeight="Bold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                        <TextBlock Text="选择传输方式并验证设备" ToolTip="选择传输方式并验证设备" FontSize="11" Opacity="0.68"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource StatusPillConnection}" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource StatusDotConnection}" />
                                                            <TextBlock Text="{Binding RealtimeConnectionStateText}" Style="{StaticResource StatusPillTextConnection}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Style="{StaticResource GuideChevronText}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                </Grid>
                                            </ToggleButton>
                                            <Border Visibility="{Binding IsChecked, ElementName=GuideConnectToggle, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Margin="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="传输方式" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="串口 Serial" IsReadOnly="True" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding SelectedBoundPairing.DdsLine, Mode=OneWay, TargetNullValue=未绑定}"
                                                                     IsReadOnly="True" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="手动绑定设备" Style="{StaticResource GuideSectionTitle}" Margin="0,12,0,0" />
                                                    <TextBlock Text="打开软件后先记录基线；每插入一套硬件，扫描新增候选后绑定标签与 USB2070 编号。"
                                                               Style="{StaticResource HintText}" Margin="0,4,0,8" />
                                                    <WrapPanel>
                                                        <Button Content="记录基线" Command="{Binding InitializeBaselineCommand}"
                                                                Style="{StaticResource PrimaryButton}" MinWidth="86" Height="32"
                                                                Margin="0,0,8,8" />
                                                        <Button Content="扫描新增" Command="{Binding DetectNewDevicesCommand}"
                                                                MinWidth="86" Height="32" Margin="0,0,8,8" />
                                                        <Button Content="扫描 SDK" Command="{Binding ScanUsb2070NumbersCommand}"
                                                                MinWidth="86" Height="32" Margin="0,0,0,8" />
                                                    </WrapPanel>

                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="新增 USB2070" Style="{StaticResource FieldLabel}" />
                                                            <ListBox ItemsSource="{Binding PendingUsb2070Candidates}"
                                                                     SelectedItem="{Binding SelectedUsb2070Candidate}"
                                                                     Height="104">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text1Brush}"
                                                                                       FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MonoText}"
                                                                                       FontSize="10" Margin="0,2,0,0" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="新增 DDS" Style="{StaticResource FieldLabel}" />
                                                            <ListBox ItemsSource="{Binding PendingDdsCandidates}"
                                                                     SelectedItem="{Binding SelectedDdsCandidate}"
                                                                     Height="104">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text1Brush}"
                                                                                       FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="{Binding Details}" Style="{StaticResource MonoText}"
                                                                                       FontSize="10" Margin="0,2,0,0" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="72" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="标签" Style="{StaticResource FieldLabel}" />
                                                            <TextBox Text="{Binding PairingLabel, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="USB号" Style="{StaticResource FieldLabel}" />
                                                            <TextBox>
                                                                <TextBox.Text>
                                                                    <Binding Path="PairingUsb2070DeviceNumber" UpdateSourceTrigger="LostFocus">
                                                                        <Binding.ValidationRules>
                                                                            <StaticResource ResourceKey="NonNegativeIntegerRule" />
                                                                        </Binding.ValidationRules>
                                                                    </Binding>
                                                                </TextBox.Text>
                                                            </TextBox>
                                                        </StackPanel>
                                                        <Button Grid.Column="4" Content="绑定" Command="{Binding BindSelectedDevicesCommand}"
                                                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding RealtimeReferenceSummary}" Style="{StaticResource HintText}"
                                                               Margin="0,12,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource WorkbenchStepCard}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <ToggleButton x:Name="GuideSettingsToggle"
                                                          Click="GuideToggle_Click"
                                                          Style="{StaticResource WorkbenchGuideHeader}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12"
                                                            Background="{StaticResource AccentTintBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="二" Foreground="{StaticResource AccentBrush}"
                                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="设置" FontWeight="Bold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                        <TextBlock Text="激励 · 采集 · 保存 / 实时成像" ToolTip="激励 · 采集 · 保存 / 实时成像" FontSize="11" Opacity="0.68"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource StatusPillPower}" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource StatusDotConnection}" />
                                                            <TextBlock Text="{Binding RealtimePowerStateText}" Style="{StaticResource StatusPillTextPower}" />
