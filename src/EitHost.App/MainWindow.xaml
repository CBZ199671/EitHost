                                               ToolTip="慢变样本无需等待稳定阈值；用户参考不会被标为低置信，也不会禁止 ROI。"
                                               Style="{StaticResource HintText}" Margin="0,3,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="45" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer x:Name="RealtimeRightRailScroll" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <StackPanel>
                                    <Border Padding="16,12"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                    <TextBlock Text="ROI 分析" Style="{StaticResource H3Text}" />
                                    <TextBlock Text="模式" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                                    <ComboBox ItemsSource="{Binding RoiModeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding RoiMode}" />
                                    <StackPanel Visibility="{Binding RoiCustomControlsVisibility}">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="形状" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding RoiShapeOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding RoiShape}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="尺寸" Style="{StaticResource FieldLabel}" />
                                                <ComboBox ItemsSource="{Binding RoiSizePresetOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding RoiSizePreset}" />
                                            </StackPanel>
                                        </Grid>
                                        <Slider Minimum="24" Maximum="260" Value="{Binding RoiSizePixels}"
                                                TickFrequency="8" IsSnapToTickEnabled="False"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Grid Visibility="{Binding RoiFixedGridVisibility}" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="极图" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding FixedRoiTemporalMapModeOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding FixedRoiTemporalMapMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="周向环" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding FixedRoiAngularRingOptions}"
                                                      SelectedItem="{Binding FixedRoiAngularRingNumber}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding FixedRoiResolutionNotice}"
                                               ToolTip="{Binding FixedRoiResolutionNotice}"
                                               Visibility="{Binding RoiFixedGridVisibility}"
                                               Foreground="#b45309" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="28" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RoiPositionSummary}" Style="{StaticResource MonoText}"
                                               FontSize="11" Margin="0,4,0,0" />
                                    <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,8,0,0"
                                            Visibility="{Binding RoiCustomControlsVisibility}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="82" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Viewbox Grid.Row="0" Stretch="Fill">
                                                <Canvas Width="520" Height="220">
                                                    <Line X1="0" X2="520" Y1="55" Y2="55" Stroke="{StaticResource DividerBrush}" />
                                                    <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="{StaticResource DividerBrush}" />
                                                    <Line X1="0" X2="520" Y1="165" Y2="165" Stroke="{StaticResource DividerBrush}" />
                                                    <Path Data="{Binding RealtimeRoiNoiseBandGeometry}"
                                                          Fill="#86efac" Opacity="0.22" IsHitTestVisible="False" />
                                                    <Path Data="{Binding RealtimeRoiRawCurveGeometry}"
                                                          Stroke="#64748b" StrokeThickness="1.0" Opacity="0.42"
                                                          StrokeLineJoin="Round" IsHitTestVisible="False" />
                                                    <Path Data="{Binding RealtimeRoiCurveGeometry}"
                                                          Stroke="#1f9d67" StrokeThickness="2.4"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <ItemsControl ItemsSource="{Binding RealtimeRoiMarkers}" Width="520" Height="220">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas Width="520" Height="220" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="{Binding Size}" Height="{Binding Size}"
                                                                         Fill="Transparent" Stroke="Transparent"
                                                                         StrokeThickness="0" ToolTip="{Binding Tooltip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                            </Viewbox>
                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding RealtimeRoiAxisStart}" Style="{StaticResource MonoText}" FontSize="10" />
                                                <TextBlock Grid.Column="1" Text="{Binding RealtimeRoiAxisMiddle}" Style="{StaticResource MonoText}" FontSize="10" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding RealtimeRoiAxisEnd}" Style="{StaticResource MonoText}" FontSize="10" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TabControl Visibility="{Binding RoiFixedGridVisibility}" Height="204" Margin="0,6,0,0">
                                        <TabItem Header="局部曲线">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="112" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Viewbox Grid.Row="0" Stretch="Fill">
                                                    <Canvas Width="520" Height="220">
                                                        <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="#94a3b8" StrokeDashArray="4,4" />
                                                        <ItemsControl ItemsSource="{Binding RealtimeFixedRoiTemporal.ContextCurves}" Width="520" Height="220">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas Width="520" Height="220" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Path Data="{Binding Geometry}" Stroke="{Binding Stroke}"
                                                                          StrokeThickness="{Binding StrokeThickness}"
                                                                          StrokeDashArray="{Binding StrokeDashArray}"
                                                                          StrokeLineJoin="Round" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                </Viewbox>
                                                <Grid Grid.Row="1" Margin="0,3,0,0" TextElement.FontFamily="Times New Roman">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RealtimeFixedRoiTemporal.AxisStart}" FontSize="10" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RealtimeFixedRoiTemporal.AxisMiddle}" FontSize="10" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RealtimeFixedRoiTemporal.AxisEnd}" FontSize="10" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ItemsControl Grid.Row="2" ItemsSource="{Binding RealtimeFixedRoiTemporal.ContextCurves}" Margin="0,3,0,0">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Stroke}" FontSize="9" Margin="0,0,8,0" /></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="径向热图">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0"><TextBlock Text="R5" FontFamily="Times New Roman" FontSize="10" VerticalAlignment="Top" /><TextBlock Text="R1" FontFamily="Times New Roman" FontSize="10" VerticalAlignment="Bottom" /></Grid>
                                                    <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                                        <Image Source="{Binding RealtimeFixedRoiTemporal.RadialHeatmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                    </Border>
                                                </Grid>
                                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="24,4,0,0" TextElement.FontFamily="Times New Roman">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RealtimeFixedRoiTemporal.AxisStart}" FontSize="10" />
                                                    <TextBlock Grid.Column="1" Text="z: -5 … 0 … +5" FontSize="10" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RealtimeFixedRoiTemporal.AxisEnd}" FontSize="10" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="周向热图">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                                    <Image Source="{Binding RealtimeFixedRoiTemporal.AngularHeatmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding RealtimeFixedRoiTemporal.AngularSummary}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="2" Text="蓝=负变化 · 白=基线 · 橙=正变化 · 固定 z∈[-5,+5]" FontSize="10" Foreground="{StaticResource Text3Brush}" />
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                    <TextBlock Text="{Binding RealtimeFixedRoiTemporal.MetricsSummary}"
                                               Visibility="{Binding RoiFixedGridVisibility}"
                                               FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RealtimeRoiSummary}" Style="{StaticResource MonoText}"
                                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="RealtimeClearRoiCurveButton"
                                                Content="清空曲线" Command="{Binding ClearRealtimeRoiCurveCommand}"
                                                MinWidth="84" Margin="0,0,8,0" />
                                        <Button x:Name="RealtimeExportRoiCsvButton"
                                                Content="导出 CSV" Command="{Binding SaveRoiCurveCommand}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="84" />
                                    </WrapPanel>
                                    <TextBlock Text="手动开始成像与 ROI" Style="{StaticResource GuideSectionTitle}"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="主按钮会自动冻结点击时刻，综合点击前当前同一工况连续段的全部质量合格帧；100 帧只是最低门槛。无需等待对象静止或通过稳定阈值，稳健统计会剔除离群帧，随后按正常置信度成像并统计 ROI。"
                                               Style="{StaticResource HintText}" FontSize="10"
                                               Margin="0,0,0,5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RealtimeReferenceWindowPreview}"
                                               Style="{StaticResource HintText}" FontSize="10"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <Button x:Name="RealtimeUseHighQualityReferenceButton"
                                            Content="{Binding RealtimeManualReferenceActionText}"
                                            ContentTemplate="{StaticResource WrappedButtonLabel}"
                                            ToolTip="按钮始终可见；点击后自动汇总操作前最近同工况连续段的全部高质量帧。100 帧只是最低门槛，无需等待稳定阈值。"
                                            Command="{Binding UseCurrentRealtimeReferenceCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="34" Margin="0,8,0,0" Padding="6,5" />
                                    <Expander x:Name="RealtimeReferenceHistoryExpander"
                                              Header="高级：选择历史参考区间"
                                              HeaderTemplate="{StaticResource WrappedHeaderLabel}"
                                              IsExpanded="False"
                                              Visibility="{Binding RealtimeReferenceWindowSelectorVisibility}"
                                              Margin="0,7,0,0">
                                        <StackPanel Margin="4,4,0,0">
                                            <TextBlock Text="仅在需要复现实验时使用。这里最多显示 8 个不重叠代表区间；主按钮始终使用点击前自动汇总结果。"
                                                       Style="{StaticResource HintText}" FontSize="10"
                                                       Margin="0,0,0,3" TextWrapping="Wrap" />
                                            <ComboBox x:Name="RealtimeReferenceWindowSelector"
                                                      ItemsSource="{Binding RealtimeReferenceWindowOptions}"
                                                      SelectedItem="{Binding SelectedRealtimeReferenceWindow}"
                                                      Height="28" Padding="5,0"
                                                      ToolTip="高级历史复现：选择固定 100 帧代表区间，不影响主按钮的自动汇总逻辑。" />
                                            <TextBlock Text="{Binding SelectedRealtimeReferenceWindow.Preview}"
                                                       Style="{StaticResource HintText}" FontSize="10"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <Button x:Name="RealtimeUseSelectedReferenceWindowButton"
                                                    Content="使用所选历史区间（高级）"
                                                    ContentTemplate="{StaticResource WrappedButtonLabel}"
                                                    Command="{Binding UseSelectedRealtimeReferenceCommand}"
                                                    MinHeight="30" Margin="0,6,0,0" Padding="6,5" />
                                        </StackPanel>
                                    </Expander>
                                    <WrapPanel Margin="0,6,0,0"
                                               Visibility="{Binding RealtimeReferenceSwitchControlsVisibility}">
                                        <Button x:Name="RealtimeConfirmReferenceSwitchButton"
                                                Content="确认切换" ToolTip="在下一有效目标边界原子切换到已准备的新参考"
                                                Command="{Binding ConfirmRealtimeReferenceSwitchCommand}"
                                                MinWidth="88" Height="28" FontSize="12" Padding="4,0" Margin="0,0,6,0" />
                                        <Button x:Name="RealtimeCancelReferenceRelockButton"
                                                Content="取消重锁" ToolTip="放弃替换参考；原参考和 ROI 保持不变"
                                                Command="{Binding CancelRealtimeReferenceRelockCommand}"
                                                MinWidth="88" Height="28" FontSize="12" Padding="4,0" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RealtimeReferenceRelockStateText}"
                                               ToolTip="{Binding RealtimeReferenceRelockStateText}"
                                               Style="{StaticResource HintText}" FontSize="10" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                    <StackPanel Visibility="{Binding RealtimeSynchronizedReferenceControlsVisibility}">
                                        <TextBlock Text="多集合共同参考时刻" Style="{StaticResource HintText}"
                                                   FontSize="10" Margin="0,9,0,3" />
                                        <WrapPanel>
                                            <Button x:Name="RealtimePrepareSynchronizedReferencesButton"
                                                    Content="同步准备" ToolTip="以一次共同操作时间，为所有运行集合选择此前最近的完整高质量窗口"
                                                    Command="{Binding PrepareSynchronizedRealtimeReferencesCommand}"
                                                    MinWidth="82" Height="28" FontSize="12" Padding="4,0" Margin="0,0,6,4" />
                                            <Button x:Name="RealtimeConfirmSynchronizedReferenceSwitchButton"
                                                    Content="统一确认" ToolTip="所有集合均准备成功后，统一确认其在各自下一有效块切换"
                                                    Command="{Binding ConfirmSynchronizedRealtimeReferenceSwitchCommand}"
                                                    MinWidth="82" Height="28" FontSize="12" Padding="4,0" Margin="0,0,6,4" />
                                            <Button x:Name="RealtimeCancelSynchronizedReferenceRelockButton"
                                                    Content="全部取消" ToolTip="在任何集合切换前，取消整个共同 action"
                                                    Command="{Binding CancelSynchronizedRealtimeReferenceRelockCommand}"
                                                    MinWidth="82" Height="28" FontSize="12" Padding="4,0" Margin="0,0,0,4" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding RealtimeSynchronizedReferenceSummary}"
                                                   ToolTip="{Binding RealtimeSynchronizedReferenceSummary}"
                                                   Style="{StaticResource HintText}" FontSize="10" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding RealtimeImagingLogs}" Margin="16,10,16,16"
                                             Height="180" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,7">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoLog}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                            <Border x:Name="RealtimeRightRailFooter" Grid.Row="2" Height="80" Padding="16,6"
                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding RealtimeImagingSummary}" Style="{StaticResource MonoText}"
                                               ToolTip="{Binding RealtimeImagingSummary}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RealtimeContactCalibrationExportStateText}"
                                               ToolTip="{Binding RealtimeContactCalibrationExportStateText}"
                                               Style="{StaticResource HintText}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button x:Name="RealtimeRelockReferenceButton"
                                                Content="准备重锁" ToolTip="后台准备替换参考；当前参考、成像和 ROI 不会中断"
                                                Command="{Binding ResetRealtimeReferenceCommand}"
                                                Width="72" Height="26" FontSize="12" Padding="4,0" Margin="0,0,4,0" />
                                        <Button x:Name="RealtimeExportDeviceCalibrationButton"
                                                Content="导出设备标定" ToolTip="导出当前设备级接触标定文件"
                                                Command="{Binding SaveRealtimeDeviceCalibrationCommand}"
                                                Width="84" Height="26" FontSize="12" Padding="2,0" Margin="0,0,4,0" />
                                        <Button x:Name="RealtimeExportSessionCalibrationButton"
                                                Content="导出会话标定" ToolTip="导出当前会话的接触标定文件"
                                                Command="{Binding SaveRealtimeContactCalibrationCommand}"
                                                Width="84" Height="26" FontSize="12" Padding="2,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ════════════ 数据记录 ════════════ -->
                <ScrollViewer x:Name="ViewData" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <Grid Margin="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- unified experiment catalog -->
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}"
                                DataContext="{Binding ExperimentWorkspace}">
                            <DockPanel LastChildFill="True" Margin="18">
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                    <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCatalogRunsCommand}"
                                            Style="{StaticResource SubtleButton}" Height="32" MinWidth="64" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="eit_catalog.sqlite · catalog-v2" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="实验数据与回放" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="一条实验统一显示 raw、解调、重构及回放覆盖；选择后自动关联离线工具和下方回放。旧数据只读显示且不会伪造关联。"
                                           Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                <Border DockPanel.Dock="Top" Background="{StaticResource SunkenBrush}"
                                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="统一数据根目录" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding DataRootPath}" Style="{StaticResource MonoText}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding DataRootStorageSummary}" Style="{StaticResource HintText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedExperimentStorageSummary}" Style="{StaticResource HintText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding RetentionPolicySummary}" Style="{StaticResource HintText}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="刷新容量" Command="{Binding RefreshDataRootStorageCommand}"
                                                    Style="{StaticResource SubtleButton}" Height="30" MinWidth="76" Margin="0,0,8,0" />
                                            <Button Content="打开数据目录" Command="{Binding OpenDataRootCommand}"
                                                    Style="{StaticResource SubtleButton}" Height="30" MinWidth="96" Margin="0,0,8,0" />
                                            <Button Content="打开所选目录" Command="{Binding OpenSelectedExperimentDirectoryCommand}"
                                                    Style="{StaticResource SubtleButton}" Height="30" MinWidth="96" Margin="0,0,8,0" />
                                            <Button Content="归档所选" Command="{Binding ArchiveSelectedExperimentCommand}"
                                                    Style="{StaticResource SubtleButton}" Height="30" MinWidth="80" Margin="0,0,8,0"
                                                    ToolTip="移动到 DataRoot/archives 并事务更新 catalog；仍可回放，不释放磁盘空间" />
                                            <Button Content="归档超期" Command="{Binding ArchiveRetentionCandidatesCommand}"
                                                    Style="{StaticResource SubtleButton}" Height="30" MinWidth="80" Margin="0,0,8,0"
                                                    ToolTip="确认后批量归档超过 90 天的终态实验；仍可回放，不会自动删除" />
                                            <Button Content="永久删除" Command="{Binding DeleteSelectedExperimentCommand}"
                                                    Style="{StaticResource DangerButton}" Height="30" MinWidth="80"
                                                    ToolTip="仅终态统一实验可删除；确认后删除 raw、派生、导出和 catalog 记录" />
                                        </WrapPanel>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="8" VerticalAlignment="Center"
                                                         Minimum="0" Maximum="{Binding RetentionArchiveTotalCount, Mode=OneWay}"
                                                         Value="{Binding RetentionArchiveCompletedCount, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding RetentionArchiveProgressSummary}"
                                                       Style="{StaticResource HintText}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Margin="10,0" />
                                            <Button Grid.Column="2" Content="取消归档"
                                                    Command="{Binding CancelRetentionArchiveCommand}"
                                                    Visibility="{Binding IsRetentionArchiveRunning, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SubtleButton}" Height="28" MinWidth="76" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,12,0,0">
                                    <!-- The summary is docked first so it reserves its own width, and
                                         never wraps: a longer locale would otherwise squeeze it into a
                                         one-character column and blow the row height up. The filter
                                         controls then wrap onto a second line instead of being clipped. -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RunFilterSummary}"
                                               Style="{StaticResource HintText}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RunFilterSummary}"
                                               MaxWidth="220" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="按日期" Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker Width="150" SelectedDate="{Binding SelectedRunDate}"
                                                    VerticalAlignment="Center" />
                                        <Button Content="清除" Command="{Binding ClearRunDateFilterCommand}"
                                                Style="{StaticResource SubtleButton}" Height="32" MinWidth="56"
                                                Margin="8,4,0,0" VerticalAlignment="Center" />
                                        <Button Content="生成离线完整回放" Command="{Binding ReconcileSelectedExperimentCommand}"
                                                Height="32" MinWidth="132" Margin="8,4,0,0" VerticalAlignment="Center"
                                                ToolTip="手动补齐解调并按记录策略完整重算；仅在全覆盖校验通过后发布独立离线 revision" />
                                        <Button Content="删除离线版本" Command="{Binding DeleteOfflineCompleteRevisionCommand}"
                                                Style="{StaticResource SubtleButton}"
                                                Height="32" MinWidth="96" Margin="8,4,0,0" VerticalAlignment="Center"
                                                ToolTip="仅删除所选实验的离线完整 revision；不删除 raw、解调数据或实时回放" />
                                        <Button x:Name="CancelCatchUpButton" Content="停止离线重算"
                                                Command="{Binding CancelCatchUpCommand}"
                                                Style="{StaticResource SubtleButton}"
                                                Height="32" MinWidth="80" Margin="8,4,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsCatchUpRunning, Converter={StaticResource BoolToVis}}"
                                                ToolTip="在当前块结束后停止；暂存 revision 不会发布，可稍后继续" />
                                        <TextBlock x:Name="CatchUpProgressText"
                                                   Text="{Binding CatchUpProgressSummary}"
                                                   ToolTip="{Binding CatchUpProgressSummary}"
                                                   Style="{StaticResource HintText}" TextWrapping="NoWrap"
                                                   MaxWidth="320" Margin="10,4,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsCatchUpRunning, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                </DockPanel>
                                <ListBox ItemsSource="{Binding ExperimentRunsView}" SelectedItem="{Binding SelectedExperimentRun}" Margin="0,12,0,0"
                                         MaxHeight="560" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}"
                                                           FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text1Brush}" />
                                                <TextBlock Text="{Binding StateLine}" Style="{StaticResource MonoText}"
                                                           Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding CoverageLine}" Style="{StaticResource MonoText}" FontSize="11" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ReplayLine}" Style="{StaticResource MonoText}" FontSize="11" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding LocationLine}" Style="{StaticResource MonoText}" FontSize="11" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- demod / inspect / export -->
                        <StackPanel Grid.Column="2" DataContext="{Binding ExperimentWorkspace.DataTools}">
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel Margin="18">
                                    <TextBlock Text="离线处理" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="离线解调" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <TextBlock Text="输入 HDF5" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DemodInputHdf5Path, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseDemodInputCommand}"
                                                Style="{StaticResource BrowseButton}" MinWidth="64" />
                                    </Grid>
                                    <TextBlock Text="统一派生输出" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding DemodOutputHdf5Path}" IsReadOnly="True" />
                                    <TextBlock Text="输出由实验 ID 自动归入 derived/ 并登记处理账本；旧版文件须先导入。"
                                               Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="执行解调" Command="{Binding DemodulateHdf5Command}" Style="{StaticResource PrimaryButton}"
                                                MinWidth="96" Margin="0,0,8,8" />
                                        <Button Content="批量解调" Command="{Binding DemodulateRecentRunsCommand}" MinWidth="96" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding DemodulationSummary}" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource Text3Brush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                                <StackPanel Margin="18">
                                    <TextBlock Text="完整性检查" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="HDF5 文件检查" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <TextBlock Text="输入 HDF5" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Hdf5InspectPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseHdf5InspectCommand}"
                                                Style="{StaticResource BrowseButton}" MinWidth="64" />
                                    </Grid>
                                    <Button Content="检查 HDF5" Command="{Binding InspectHdf5Command}" HorizontalAlignment="Left"
                                            MinWidth="104" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Hdf5InspectionSummary}" Style="{StaticResource BodyText}"
                                               Foreground="{StaticResource Text3Brush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                                <StackPanel Margin="18">
                                    <TextBlock Text="导出" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="HDF5 导出 CSV" Style="{StaticResource H3Text}" Margin="0,2,0,12" />
                                    <TextBlock Text="源 HDF5" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding ExportSourceHdf5Path, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseExportSourceCommand}"
                                                Style="{StaticResource BrowseButton}" MinWidth="64" />
                                    </Grid>
                                    <TextBlock Text="Dataset" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding ExportDatasetPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="统一导出位置" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding ExportCsvPath}" IsReadOnly="True" />
                                    <TextBlock Text="CSV 自动归入同一实验的 exports/ 并记录来源 HDF5、Dataset 与筛选条件。"
                                               Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Filter" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding ExportFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource PrimaryButton}"
                                                MinWidth="96" Margin="0,0,8,8" />
                                        <Button Content="批量 raw CSV" Command="{Binding ExportRecentRawCsvCommand}" MinWidth="116" Margin="0,0,0,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- selected experiment replay (V143/V413) -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource PanelCard}" Margin="0,18,0,0"
                                DataContext="{Binding VisualizationWorkspace}">
                            <DockPanel Margin="18" LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="所选实验 · 派生成像" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="实验回放" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="实时回放只包含采集期间实际完成逆问题并提交到界面的帧；离线回放只使用手动完整重算后发布的全覆盖 revision。两条线路的重构值、显示参数、ROI 与导出相互隔离。"
                                           Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding ReplayRunSummary}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource Text2Brush}" FontSize="12" />
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SunkenBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                    CornerRadius="8" Padding="8">
                                                <Viewbox Width="300" Height="300" Stretch="Uniform">
                                                    <Canvas x:Name="ReplayRoiCanvas"
                                                            Width="{Binding RoiImageCanvasSize}"
                                                            Height="{Binding RoiImageCanvasSize}"
                                                            Background="Transparent"
                                                            ClipToBounds="True"
                                                            Cursor="Cross"
                                                            MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                                            MouseMove="RoiCanvas_MouseMove"
                                                            MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp">
                                                        <Image Source="{Binding ReplayImageSource}"
                                                               Width="{Binding RoiImageCanvasSize}"
                                                               Height="{Binding RoiImageCanvasSize}"
                                                               Stretch="Uniform" />
                                                        <ItemsControl ItemsSource="{Binding ReplayFixedRoiMapCells}"
                                                                      Visibility="{Binding RoiFixedGridVisibility}"
                                                                      Width="{Binding RoiImageCanvasSize}"
                                                                      Height="{Binding RoiImageCanvasSize}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas Width="{Binding DataContext.RoiImageCanvasSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            Height="{Binding DataContext.RoiImageCanvasSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Path Data="{Binding Geometry}" Fill="{Binding Fill}"
                                                                          Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Path Data="{Binding ReplayFixedRoiTemporal.CentroidTrajectory}"
                                                              Visibility="{Binding RoiFixedGridVisibility}"
                                                              Stroke="#fff7ed" StrokeThickness="2.6" StrokeDashArray="4,3"
                                                              IsHitTestVisible="False" />
                                                        <Ellipse Canvas.Left="{Binding ReplayFixedRoiTemporal.CentroidLeft}"
                                                                 Canvas.Top="{Binding ReplayFixedRoiTemporal.CentroidTop}"
                                                                 Width="12" Height="12" Fill="#fff7ed" Stroke="#9a3412"
                                                                 StrokeThickness="2" Visibility="{Binding ReplayFixedRoiTemporal.CentroidVisibility}"
                                                                 IsHitTestVisible="False" />
                                                        <Path Data="{Binding FixedRoiSelectionGeometry}"
                                                              Visibility="{Binding RoiFixedGridVisibility}"
                                                              Fill="#44f4c430" Stroke="#f4c430" StrokeThickness="2.5"
                                                              IsHitTestVisible="False" />
                                                        <Path Data="{Binding FixedRoiGridGeometry}"
                                                              Visibility="{Binding RoiFixedGridVisibility}"
                                                              Stroke="#e6f8fafc" StrokeThickness="1.4"
                                                              IsHitTestVisible="False" />
                                                        <Rectangle Canvas.Left="{Binding RoiOverlayLeft}"
                                                                   Canvas.Top="{Binding RoiOverlayTop}"
                                                                   Width="{Binding RoiOverlaySize}"
                                                                   Height="{Binding RoiOverlaySize}"
                                                                   Visibility="{Binding RoiSquareVisibility}"
                                                                   Stroke="#f4c430" StrokeThickness="3"
                                                                   StrokeDashArray="7,4" Fill="#22f4c430"
                                                                   IsHitTestVisible="False" />
                                                        <Ellipse Canvas.Left="{Binding RoiOverlayLeft}"
                                                                 Canvas.Top="{Binding RoiOverlayTop}"
                                                                 Width="{Binding RoiOverlaySize}"
                                                                 Height="{Binding RoiOverlaySize}"
                                                                 Visibility="{Binding RoiCircleVisibility}"
                                                                 Stroke="#f4c430" StrokeThickness="3"
                                                                 StrokeDashArray="7,4" Fill="#22f4c430"
                                                                 IsHitTestVisible="False" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SunkenBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                    CornerRadius="8" Padding="8"
                                                    Visibility="{Binding RoiCustomControlsVisibility}">
                                                <!-- Height matches the 300px replay image beside it: an
                                                     unbounded Stretch="Fill" Viewbox would scale by width
                                                     alone and stretch this row on wide monitors. -->
                                                <Viewbox Stretch="Fill" Height="300">
                                                    <Canvas Width="520" Height="220">
                                                        <Line X1="0" X2="520" Y1="55" Y2="55" Stroke="{StaticResource DividerBrush}" />
                                                        <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="{StaticResource DividerBrush}" />
                                                        <Line X1="0" X2="520" Y1="165" Y2="165" Stroke="{StaticResource DividerBrush}" />
                                                        <Path Data="{Binding ReplayCurveGeometry}"
                                                              Stroke="#0b78c8" StrokeThickness="2.4"
                                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                        <Slider Grid.Row="2" Margin="0,12,0,0" Minimum="0"
                                                Maximum="{Binding ReplayMaxFrameIndex, Mode=OneWay}"
                                                Value="{Binding ReplayFrameIndex}"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                IsEnabled="{Binding HasReplayFrames}" />
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Width="210">
                                                <ComboBox ItemsSource="{Binding RoiModeOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding RoiMode}" />
                                                <StackPanel Visibility="{Binding RoiCustomControlsVisibility}">
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0" ItemsSource="{Binding RoiShapeOptions}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding RoiShape}" />
                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding RoiSizePresetOptions}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding RoiSizePreset}" />
                                                    </Grid>
                                                    <Slider Minimum="24" Maximum="260" Value="{Binding RoiSizePixels}"
                                                            Margin="0,8,0,0" />
                                                </StackPanel>
                                                <Grid Visibility="{Binding RoiFixedGridVisibility}" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="极图" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox ItemsSource="{Binding FixedRoiTemporalMapModeOptions}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                  SelectedValue="{Binding FixedRoiTemporalMapMode}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="周向环" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox ItemsSource="{Binding FixedRoiAngularRingOptions}"
                                                                  SelectedItem="{Binding FixedRoiAngularRingNumber}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding FixedRoiResolutionNotice}"
                                                           Visibility="{Binding RoiFixedGridVisibility}"
                                                           Foreground="#b45309" FontSize="11"
                                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding RoiPositionSummary}" Style="{StaticResource MonoText}"
                                                           FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="计算 ROI" Command="{Binding CalculateReplayRoiCommand}"
                                                            Style="{StaticResource PrimaryButton}" MinWidth="82" Margin="0,0,8,0" />
                                                    <Button Content="导出 CSV" Command="{Binding SaveRoiCurveCommand}"
                                                            MinWidth="82" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource SunkenBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                                    CornerRadius="8" Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding ReplayRoiSummary}"
                                                               Style="{StaticResource MonoText}" FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,6,0,0" Height="98">
                                                        <Canvas Width="520" Height="220">
                                                            <Line X1="0" X2="520" Y1="55" Y2="55" Stroke="{StaticResource DividerBrush}" />
                                                            <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="{StaticResource DividerBrush}" />
                                                            <Line X1="0" X2="520" Y1="165" Y2="165" Stroke="{StaticResource DividerBrush}" />
                                                            <Path Data="{Binding ReplayRoiCurveGeometry}"
                                                                  Stroke="#1f9d67" StrokeThickness="2.4"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                            <ItemsControl ItemsSource="{Binding ReplayRoiMarkers}" Width="520" Height="220">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas Width="520" Height="220" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Ellipse Width="{Binding Size}" Height="{Binding Size}"
                                                                                 Fill="Transparent" Stroke="Transparent"
                                                                                 StrokeThickness="0" ToolTip="{Binding Tooltip}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ReplayRoiAxisStart}" Style="{StaticResource MonoText}" FontSize="10" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ReplayRoiAxisMiddle}" Style="{StaticResource MonoText}" FontSize="10" HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ReplayRoiAxisEnd}" Style="{StaticResource MonoText}" FontSize="10" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TabControl Grid.Column="2" Visibility="{Binding RoiFixedGridVisibility}" Height="208">
                                                <TabItem Header="局部曲线">
                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <Viewbox Grid.Row="0" Stretch="Fill">
                                                            <Canvas Width="520" Height="220">
                                                                <Line X1="0" X2="520" Y1="110" Y2="110" Stroke="#94a3b8" StrokeDashArray="4,4" />
                                                                <ItemsControl ItemsSource="{Binding ReplayFixedRoiTemporal.ContextCurves}" Width="520" Height="220">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="520" Height="220" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Path Data="{Binding Geometry}" Stroke="{Binding Stroke}"
                                                                                  StrokeThickness="{Binding StrokeThickness}"
                                                                                  StrokeDashArray="{Binding StrokeDashArray}" StrokeLineJoin="Round" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Grid Grid.Row="1" Margin="0,3,0,0" TextElement.FontFamily="Times New Roman">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ReplayFixedRoiTemporal.AxisStart}" FontSize="10" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ReplayFixedRoiTemporal.AxisMiddle}" FontSize="10" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ReplayFixedRoiTemporal.AxisEnd}" FontSize="10" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding ReplayFixedRoiTemporal.ContextCurves}" Margin="0,3,0,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Stroke}" FontSize="9" Margin="0,0,10,0" /></DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </TabItem>
                                                <TabItem Header="径向热图">
                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0"><TextBlock Text="R5" FontFamily="Times New Roman" FontSize="10" VerticalAlignment="Top" /><TextBlock Text="R1" FontFamily="Times New Roman" FontSize="10" VerticalAlignment="Bottom" /></Grid>
                                                            <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                                                <Image Source="{Binding ReplayFixedRoiTemporal.RadialHeatmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                            </Border>
                                                        </Grid>
                                                        <Grid Grid.Row="1" Margin="28,4,0,0" TextElement.FontFamily="Times New Roman">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding ReplayFixedRoiTemporal.AxisStart}" FontSize="10" />
                                                            <TextBlock Grid.Column="1" Text="z: -5 … 0 … +5" FontSize="10" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ReplayFixedRoiTemporal.AxisEnd}" FontSize="10" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="2" Text="{Binding ReplayFixedRoiTemporal.MetricsSummary}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </Grid>
                                                </TabItem>
                                                <TabItem Header="周向热图">
                                                    <Grid Margin="6">
                                                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                                                            <Image Source="{Binding ReplayFixedRoiTemporal.AngularHeatmap}" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>
                                                        <TextBlock Grid.Row="1" Text="{Binding ReplayFixedRoiTemporal.AngularSummary}" FontSize="10" Margin="0,4,0,0" />
                                                        <TextBlock Grid.Row="2" Text="蓝=负变化 · 白=基线 · 橙=正变化 · 固定 z∈[-5,+5]" FontSize="10" Foreground="{StaticResource Text3Brush}" />
                                                        <TextBlock Grid.Row="3" Text="{Binding ReplayFixedRoiTemporal.MetricsSummary}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    </Grid>
                                                </TabItem>
                                            </TabControl>
                                        </Grid>
                                        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="{Binding LiveReplayButtonText}"
                                                        Command="{Binding ToggleLiveReplayCommand}"
                                                        Style="{StaticResource PrimaryButton}" MinWidth="112"
                                                        ToolTip="仅回放实时采集期间实际显示并提交的重构帧" />
                                                <Button Content="{Binding OfflineReplayButtonText}"
                                                        Command="{Binding ToggleOfflineReplayCommand}"
                                                        MinWidth="112" Margin="8,0,0,0"
                                                        ToolTip="仅回放手动完整重算并原子发布的 offline-complete revision" />
                                            </StackPanel>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ReplayLaneSummary}" Style="{StaticResource MonoText}"
                                                           Foreground="{StaticResource Text2Brush}" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ReplayLoadStatus}" Style="{StaticResource MonoText}"
                                                           ToolTip="{Binding ReplayLoadStatus}"
                                                           Foreground="#0b78c8" FontSize="11"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                           Height="16" />
                                                <!-- B178/V293: both summaries keep a fixed line box; frames with and
                                                     without reconstruction produce different text lengths, and a
                                                     1↔2-line wrap toggle made the whole panel jump every frame. -->
                                                <TextBlock Text="{Binding ReplayFrameSummary}" Style="{StaticResource MonoText}"
                                                           ToolTip="{Binding ReplayFrameSummary}"
                                                           Foreground="{StaticResource Text3Brush}" FontSize="12"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                           Height="32" />
                                                <TextBlock Text="{Binding ReplayContactSummary}" Style="{StaticResource MonoText}"
                                                           ToolTip="{Binding ReplayContactSummary}"
                                                           Foreground="{StaticResource Text2Brush}" FontSize="12"
                                                           Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                           Height="48" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ════════════ 系统日志 ════════════ -->
                <ScrollViewer x:Name="ViewLog" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Margin="24">
                        <!-- live activity log (auto) -->
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel Margin="18">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="命令 / 数据包 / 采集 / 导出" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="实时活动日志" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource ChipInfo}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActivityLogs.Count, StringFormat=最近 {0} 条}"
                                                   Style="{StaticResource ChipTextNeutral}" Foreground="{StaticResource InfoFgBrush}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="集中显示需要操作员关注的状态、警告与失败；各面板的高频明细不再重复插入。"
                                           Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                <Border Background="{StaticResource SunkenBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <ListBox ItemsSource="{Binding ActivityLogs}" MaxHeight="420"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MonoLog}" /></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- field evidence snapshot (single export) -->
                        <Border Style="{StaticResource PanelCard}" Margin="0,18,0,0">
                            <StackPanel Margin="18">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <TextBlock Text="现场证据导出" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="一键现场快照" Style="{StaticResource H3Text}" Margin="0,2,0,0" />
                                        <TextBlock Text="一次性打包硬件报告、配对清单、T25 计划与证据索引，写入 outputs 目录。"
                                                   Style="{StaticResource HintText}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="导出现场快照" Command="{Binding ExportFieldSnapshotCommand}"
                                            Style="{StaticResource PrimaryButton}" MinWidth="130" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding FieldSnapshotSummary}" Style="{StaticResource HintText}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding FieldSnapshotPath}" Style="{StaticResource MonoText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Transient toast removed: latest activity already shown in the
                     right-hand 已录制的帧 feed, the bottom status bar, and 系统日志. -->
            </Grid>
        </DockPanel>
</Window>
