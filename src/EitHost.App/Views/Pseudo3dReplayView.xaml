<UserControl x:Class="EitHost.App.Views.Pseudo3dReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding Visibility}">
    <Border Background="#F4F8FC" BorderBrush="#BDD3E6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,14">
        <StackPanel>
            <TextBlock Text="伪三维 · 双设备采集回放" FontWeight="Bold" FontSize="17" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,7,0,0" />
            <TextBlock Text="按同一采集轮次同步查看双层原始电压、二维重构及保存的三维结果。空白表示本轮未生成该结果。"
                       TextWrapping="Wrap" Foreground="#475569" Margin="0,5,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding LowerLabel}" TextWrapping="Wrap" MinHeight="38" />
                    <Image Source="{Binding LowerImage}" Height="175" Stretch="Uniform" />
                    <Viewbox Stretch="Fill" Height="70" Margin="0,4,0,0">
                        <Canvas Width="500" Height="100" Background="#EDF3FA">
                            <Path Data="{Binding LowerCurve}" Stroke="#087DC1" StrokeThickness="2" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="208通道边界电压幅值" FontSize="11" FontFamily="Times New Roman, Microsoft YaHei UI" Foreground="#475569" />
                    <TextBlock Text="{Binding UpperLabel}" TextWrapping="Wrap" MinHeight="38" Margin="0,14,0,0" />
                    <Image Source="{Binding UpperImage}" Height="175" Stretch="Uniform" />
                    <Viewbox Stretch="Fill" Height="70" Margin="0,4,0,0">
                        <Canvas Width="500" Height="100" Background="#EDF3FA">
                            <Path Data="{Binding UpperCurve}" Stroke="#B45422" StrokeThickness="2" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="208通道边界电压幅值" FontSize="11" FontFamily="Times New Roman, Microsoft YaHei UI" Foreground="#475569" />
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Image Source="{Binding VolumeImage}" Stretch="Uniform" MaxHeight="540" />
                    <TextBlock Grid.Row="1" Text="{Binding ColorScale}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               FontFamily="Times New Roman, Microsoft YaHei UI" Margin="0,6,0,0" />
                </Grid>
            </Grid>
            <Slider Minimum="0" Maximum="{Binding MaxFrameIndex}" Value="{Binding FrameIndex, Mode=TwoWay}"
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,14,0,8" />
            <WrapPanel>
                <Button Content="上一轮" Command="{Binding PreviousCommand}" MinWidth="80" Margin="0,0,8,6" />
                <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" MinWidth="136" Margin="0,0,8,6" />
                <Button Content="下一轮" Command="{Binding NextCommand}" MinWidth="80" Margin="0,0,8,6" />
                <Button Content="刷新组回放" Command="{Binding ReloadCommand}" MinWidth="100" Margin="0,0,8,6" />
            </WrapPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#315570" MinHeight="36" />
            <CheckBox Content="查看所选设备的二维显示记录 / 离线回放" IsChecked="{Binding ShowDeviceReplay}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
