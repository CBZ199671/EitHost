<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:validation="clr-namespace:EitHost.App.Validation">

    <!-- ════════ EitHost design tokens ════════
         Light-mode instrument palette on a single engineering-blue accent.
         Mirrors tokens/colors.css from the EitHost design system. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Fonts. Production renders Microsoft YaHei UI; mono = JetBrains Mono
         with Cascadia/Consolas fallback (JetBrains Mono ships with the app font
         stack only as a web substitute, so the WPF host falls back to Consolas). -->
    <FontFamily x:Key="SansFont">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Accent · engineering blue -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0b6fb8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0a63a4" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#095688" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#e8f2fb" />
    <SolidColorBrush x:Key="AccentTint2Brush" Color="#d4e7f7" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#f5fafe" />

    <!-- Canvas & surfaces -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#eef3f8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="SunkenBrush" Color="#f5f8fc" />
    <SolidColorBrush x:Key="MutedBrush" Color="#f0f4f9" />

    <!-- Deep chrome (rail) -->
    <SolidColorBrush x:Key="InkRailBrush" Color="#142533" />
    <SolidColorBrush x:Key="InkRailElevBrush" Color="#1b3344" />
    <SolidColorBrush x:Key="InkRailHoverBrush" Color="#213c50" />
    <SolidColorBrush x:Key="InkRailTextBrush" Color="#e6edf3" />
    <SolidColorBrush x:Key="InkRailMutedBrush" Color="#8395a4" />

    <!-- Borders & dividers -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#cfd8e3" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#aebccc" />
    <SolidColorBrush x:Key="DividerBrush" Color="#dce3ec" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text1Brush" Color="#131d27" />
    <SolidColorBrush x:Key="Text2Brush" Color="#354150" />
    <SolidColorBrush x:Key="Text3Brush" Color="#586471" />

    <!-- Semantic state tones -->
    <SolidColorBrush x:Key="NeutralFgBrush" Color="#51606f" />
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#f1f4f8" />
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="#d8e0ea" />
    <SolidColorBrush x:Key="InfoFgBrush" Color="#0a5d92" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="#e8f2fb" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#b6d6ee" />
    <SolidColorBrush x:Key="ReadyFgBrush" Color="#08744b" />
    <SolidColorBrush x:Key="ReadyBgBrush" Color="#d6f1e2" />
    <SolidColorBrush x:Key="ReadyBorderBrush" Color="#4ebd8b" />
    <SolidColorBrush x:Key="ActiveFgBrush" Color="#075a97" />
    <SolidColorBrush x:Key="ActiveBgBrush" Color="#d2e7fb" />
    <SolidColorBrush x:Key="ActiveBorderBrush" Color="#4c9fe0" />
    <SolidColorBrush x:Key="WarnFgBrush" Color="#97600c" />
    <SolidColorBrush x:Key="WarnBgBrush" Color="#fbf0d8" />
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#ecca84" />
    <SolidColorBrush x:Key="ErrorFgBrush" Color="#b32d22" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#fceae8" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#f0b3ac" />
    <SolidColorBrush x:Key="ErrorPressBrush" Color="#9d2018" />

    <!-- ════════ Type ramp ════════ -->
    <Style x:Key="DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Tracked uppercase micro-label / eyebrow -->
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>
    <!-- Field label above an input -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Tabular mono for every number / hex / path / port -->
    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Content templates that let a localized label wrap instead of being clipped
         when the translated string is longer than its Chinese source. -->
    <DataTemplate x:Key="WrappedButtonLabel">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="WrappedCheckLabel">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>

    <Style x:Key="MonoLog" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="Foreground" Value="#35414D" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- ════════ Panel / card surface ════════ -->
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#142533" Opacity="0.05" BlurRadius="4" ShadowDepth="1" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════ Buttons ════════ -->
    <ControlTemplate x:Key="EhButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="bd"
                CornerRadius="8"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Implicit Button = secondary (white, strong border) -->
    <Style TargetType="Button">
        <Setter Property="Template" Value="{StaticResource EhButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource ErrorFgBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrorFgBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ErrorPressBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrorPressBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ════════ EIT 工作站 chrome / toolbar ════════ -->
    <Style x:Key="WindowChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WindowChromeCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ErrorFgBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrorFgBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkbenchToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MutedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkbenchPrimaryToolButton" TargetType="Button" BasedOn="{StaticResource WorkbenchToolButton}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="WorkbenchDangerToolButton" TargetType="Button" BasedOn="{StaticResource WorkbenchToolButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrorFgBrush}" />
    </Style>

    <Style x:Key="WorkbenchTabItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="18,0"
                            Margin="0,0,0,-1">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="bar" Height="3" VerticalAlignment="Bottom"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkbenchStepCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="WorkbenchStepHeaderDark" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="9,9,0,0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="WorkbenchStepHeaderLight" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="9,9,0,0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="WorkbenchGuideHeader" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="9"
                            Padding="12,10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ActiveBgBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
                            <Setter TargetName="bd" Property="CornerRadius" Value="9,9,0,0" />
                            <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GuideChevronText" TargetType="TextBlock">
        <Setter Property="Text" Value="▾" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="点击展开/收起" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Text" Value="▴" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GuideSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- A Grid, not a horizontal StackPanel: the label column must be
                         constrained so a long translated caption wraps instead of
                         running past the check box. -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Grid.Column="0"
                                Width="18"
                                Height="18"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="Mark"
                                       Text="✓"
                                       Foreground="{StaticResource OnAccentBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Start buttons: accent while idle, light-blue "running" pill once the set
         is live. The bound flag (IsSelectedExciting / IsSelectedAcquiring) is set
         on the button via a DataTrigger reference below. -->
    <Style x:Key="StartExcitationButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectedExciting}" Value="True">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StartAcquisitionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectedAcquiring}" Value="True">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small square ghost button used as a "browse…" affix beside path inputs. -->
    <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="{StaticResource MutedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    </Style>

    <!-- ════════ Rail nav item (RadioButton) ════════ -->
    <Style x:Key="RailNavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkRailTextBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Height="42" Padding="16,0">
                        <Grid>
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="-10,9,0,9"
                                    CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource InkRailHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource InkRailElevBrush}" />
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════ Run parameter validation ════════
         Shared, stateless rules. Bound fields report format and range problems inline
         instead of silently keeping the previous value until the domain layer rejects
         the run at start time. Bounds mirror the domain validators:
         Usb2070AcquisitionSettings, DdsDacSettings, DdsExcitationSettings,
         RealtimeDemodulationSettings and RealtimeReconstructionRequest. -->
    <validation:RunParameterRangeRule x:Key="PositiveIntegerRule"
                                      Minimum="0" MinimumInclusive="False" />
    <validation:RunParameterRangeRule x:Key="NonNegativeIntegerRule"
                                      Minimum="0" MinimumInclusive="True" />
    <validation:RunParameterRangeRule x:Key="OneBasedChannelRule"
                                      Minimum="1" MinimumInclusive="True" />
    <!-- USB2070 caps a single read at Usb2070Constants.ReadMaxLength (1572864) values
         across 16 measurement channels, so a configured block cannot exceed 98304 rows. -->
    <validation:RunParameterRangeRule x:Key="ReadSampleRowsRule"
                                      Minimum="1" MinimumInclusive="True"
                                      Maximum="98304" MaximumInclusive="True" />
    <validation:RunParameterRangeRule x:Key="PositiveDecimalRule"
                                      AllowDecimal="True"
                                      Minimum="0" MinimumInclusive="False" />
    <validation:RunParameterRangeRule x:Key="NonNegativeDecimalRule"
                                      AllowDecimal="True"
                                      Minimum="0" MinimumInclusive="True" />
    <validation:RunParameterRangeRule x:Key="Pseudo3dDisplayLayerRule"
                                      Minimum="2" MinimumInclusive="True"
                                      Maximum="9" MaximumInclusive="True" />
    <validation:RunParameterRangeRule x:Key="Pseudo3dNormalizedHeightRule"
                                      AllowDecimal="True"
                                      Minimum="0.1" MinimumInclusive="True"
                                      Maximum="10" MaximumInclusive="True" />
    <validation:RunParameterRangeRule x:Key="Pseudo3dPairSkewRule"
                                      Minimum="1" MinimumInclusive="True"
                                      Maximum="60000" MaximumInclusive="True" />

    <!-- ════════ Text input ════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The control template paints the invalid state, so the stock red adorner is
             suppressed to avoid a second, unthemed rectangle over the field. -->
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SunkenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource MutedBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
                        </Trigger>
                        <!-- Invalid entry stays visible even while the field keeps focus, so the
                             operator cannot leave a rejected value believing it was applied. -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource ErrorBgBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ErrorFgBrush}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource ErrorFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Surfaces the concrete reason and the accepted range. Fields that declare their
                 own ToolTip keep it; the template still paints the invalid state. -->
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=(Validation.Errors)[0].ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ════════ ComboBox ════════ -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="bd" CornerRadius="8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Text3Brush}" StrokeThickness="1.4" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" CornerRadius="8" Margin="0,4,0,0"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#142533" Opacity="0.16" BlurRadius="14" ShadowDepth="3" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTint2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════ ListBox ════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="8" Padding="10,8" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SunkenBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════ Status chip (pill) ════════
         Use a Border styled per tone, with a TextBlock inside. -->
    <Style x:Key="ChipBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="ChipNeutral" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource NeutralBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}" />
    </Style>
    <Style x:Key="ChipReady" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
    </Style>
    <Style x:Key="ChipActive" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
    </Style>
    <Style x:Key="ChipInfo" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource InfoBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
    </Style>

    <Style x:Key="ChipTextNeutral" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}" />
    </Style>
    <Style x:Key="ChipTextReady" TargetType="TextBlock" BasedOn="{StaticResource ChipTextNeutral}">
        <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
    </Style>
    <Style x:Key="ChipTextActive" TargetType="TextBlock" BasedOn="{StaticResource ChipTextNeutral}">
        <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
    </Style>

    <Style x:Key="StatusPillBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusPillNeutral" TargetType="Border" BasedOn="{StaticResource StatusPillBase}">
        <Setter Property="Background" Value="{StaticResource NeutralBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}" />
    </Style>
    <Style x:Key="StatusPillReady" TargetType="Border" BasedOn="{StaticResource StatusPillBase}">
        <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
    </Style>
    <Style x:Key="StatusPillActive" TargetType="Border" BasedOn="{StaticResource StatusPillBase}">
        <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
    </Style>
    <Style x:Key="StatusPillTextNeutral" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusPillTextReady" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
    </Style>
    <Style x:Key="StatusPillTextActive" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
    </Style>

    <!-- Clickable failure pill. The status line always shows the newest message, so this keeps an
         earlier failure discoverable after routine progress text has replaced it. -->
    <Style x:Key="StatusErrorBadgeButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource ErrorFgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Height="24"
                            Background="{StaticResource ErrorBgBrush}"
                            BorderBrush="{StaticResource ErrorBorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ErrorFgBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusPillConnection" TargetType="Border" BasedOn="{StaticResource StatusPillNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeConnectionStateText}" Value="已连接">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillPower" TargetType="Border" BasedOn="{StaticResource StatusPillNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimePowerStateText}" Value="ON">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillRecording" TargetType="Border" BasedOn="{StaticResource StatusPillNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeRecordingStateText}" Value="开">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillAcquisition" TargetType="Border" BasedOn="{StaticResource StatusPillNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeAcquisitionStateText}" Value="RUN">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillTextConnection" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeConnectionStateText}" Value="已连接">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillTextPower" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimePowerStateText}" Value="ON">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillTextRecording" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeRecordingStateText}" Value="开">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillTextAcquisition" TargetType="TextBlock" BasedOn="{StaticResource StatusPillTextNeutral}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeAcquisitionStateText}" Value="RUN">
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusDotConnection" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource NeutralFgBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeConnectionStateText}" Value="已连接">
                <Setter Property="Fill" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusDotAcquisition" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{StaticResource NeutralFgBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeAcquisitionStateText}" Value="RUN">
                <Setter Property="Fill" Value="{StaticResource ActiveFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NeutralBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,6" />
    </Style>

    <Style x:Key="StatusValueConnection" TargetType="Border" BasedOn="{StaticResource StatusValueBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeConnectionStateText}" Value="已连接">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValuePower" TargetType="Border" BasedOn="{StaticResource StatusValueBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimePowerStateText}" Value="ON">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueRecording" TargetType="Border" BasedOn="{StaticResource StatusValueBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeRecordingStateText}" Value="开">
                <Setter Property="Background" Value="{StaticResource ReadyBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ReadyBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueAcquisition" TargetType="Border" BasedOn="{StaticResource StatusValueBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeAcquisitionStateText}" Value="RUN">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextConnection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeConnectionStateText}" Value="已连接">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextPower" TargetType="TextBlock" BasedOn="{StaticResource StatusValueTextConnection}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimePowerStateText}" Value="ON">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextRecording" TargetType="TextBlock" BasedOn="{StaticResource StatusValueTextConnection}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeRecordingStateText}" Value="开">
                <Setter Property="Foreground" Value="{StaticResource ReadyFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusValueTextAcquisition" TargetType="TextBlock" BasedOn="{StaticResource StatusValueTextConnection}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeAcquisitionStateText}" Value="RUN">
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ════════ Live status indicators ════════
         Bound = online (green, softly glowing). Flips to accent blue while the
         set is actually exciting or acquiring. Bind the host element's
         DataContext to a PairingSummaryItem. -->
    <SolidColorBrush x:Key="OnlineDotBrush" Color="#16a34a" />
    <SolidColorBrush x:Key="ActiveDotBrush" Color="#0b6fb8" />

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource OnlineDotBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#16a34a" BlurRadius="9" ShadowDepth="0" Opacity="0.85" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Fill" Value="{StaticResource ActiveDotBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#0b6fb8" BlurRadius="11" ShadowDepth="0" Opacity="0.95" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- State pill that recolours itself from a bound bool (DDS / 采集). -->
    <Style x:Key="StatusChipDds" TargetType="Border" BasedOn="{StaticResource ChipReady}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExciting}" Value="True">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusChipAcquire" TargetType="Border" BasedOn="{StaticResource ChipReady}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAcquiring}" Value="True">
                <Setter Property="Background" Value="{StaticResource ActiveBgBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ActiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusChipTextDds" TargetType="TextBlock" BasedOn="{StaticResource ChipTextReady}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExciting}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusChipTextAcquire" TargetType="TextBlock" BasedOn="{StaticResource ChipTextReady}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAcquiring}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ActiveFgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
